# DocSaathi AI — Frontend Environment Variables

# Backend API Base URL (Yash's service)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional Mock Mode fallback toggle (set to true to enable demo fallback when backend is offline)
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=true

# Note: NEVER expose Gemini or LLM API keys in frontend environment files.
